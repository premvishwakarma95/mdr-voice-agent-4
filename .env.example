# Copy to .env and fill in real values. Never commit .env itself.
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
EVERLY_ASSISTANT_ID=
AGENT_NAME=Agent 4 (stagging)

# Where Vapi sends tool-calls / end-of-call-report. `npm run assistant:create`
# pushes this value to the assistant — double-check it before every push.
ORCHESTRATION_WEBHOOK_URL=

MDR_API_BASE_URL=https://staging.mydrayrate.com/api
MDR_API_KEY=

PORT=3003

# Shared secret MDR must send as the x-api-key header on POST /webhooks/mdr/capture.
TEST_DISPATCH_API_KEY=

# Calling window (Mon-Fri, carrier's local time zone) — confirmed client rule.
CALLING_WINDOW_DAYS=Mon,Tue,Wed,Thu,Fri
CALLING_WINDOW_START_HOUR=9
CALLING_WINDOW_END_HOUR=18
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_SECRET=
MONGODB_URI=
