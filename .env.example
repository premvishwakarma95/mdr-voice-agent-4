# Copy to .env and fill in real values. Never commit .env itself.
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
EVERLY_ASSISTANT_ID=
AGENT_NAME=Agent 4 (stagging)

# Where Vapi sends tool-calls / end-of-call-report. `npm run assistant:create`
# pushes this value to the assistant — double-check it before every push.
ORCHESTRATION_WEBHOOK_URL=

MDR_API_BASE_URL=https://staging.mydrayrate.com/api
MDR_API_KEY=

PORT=3003

# Shared secret (same as Agent 2 staging) — required as the x-api-key header on
# POST /webhooks/mdr/capture and POST /dispatch/run.
TEST_DISPATCH_API_KEY=

# Calling window, in the broker's local time. MDR's payload has no timezone, so
# CALLING_TIMEZONE (IANA name) is used; defaults to America/New_York if unset.
CALLING_WINDOW_DAYS=Mon,Tue,Wed,Thu,Fri
CALLING_WINDOW_START_HOUR=9
CALLING_WINDOW_END_HOUR=18
CALLING_TIMEZONE=America/New_York

# Max real dials per 5-minute dispatch cycle (default 5).
MAX_DIALS_PER_CYCLE=5
# Set to false to run the server without the auto-dialing cron.
DISPATCH_CRON_ENABLED=true

# Optional. When set, assistant:create pushes it to Vapi as server.secret and
# /vapi/tool-calls rejects requests without a matching x-vapi-secret header.
# Set it on the server AND re-run assistant:create together, or tool calls 401.
VAPI_SERVER_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_SECRET=
MONGODB_URI=
